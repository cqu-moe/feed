{
  "browserHeadless": true,
  "browserEngine": "chromium",
  "browserWidth": 1280,
  "browserHeight": 720,
  "browserSingleProcess": false,
  "browserBypassCSP": false,
  "browserLoadMaxTime": 60000,
  "browserCaptureMaxTime": 60000,
  "browserWaitUntil": "networkIdle",
  "browserWaitUntilDelay": 1000,
  "browserWaitUntilFallback": true,
  "blockAudios": true,
  "blockAlternativeImages": true,
  "blockScripts": true,
  "blockStylesheets": false,
  "blockVideos": true,
  "loadDeferredContent": true,
  "loadDeferredContentDispatchScrollEvent": true,
  "loadDeferredContentMaxIdleTime": 1500,
  "maxResourceSize": 10,
  "compressHTML": true,
  "removeHiddenElements": true,
  "removeUnusedStyles": true,
  "removeUnusedFonts": true,
  "removeAlternativeFonts": true,
  "removeAlternativeMedias": true,
  "removeAlternativeImages": true,
  "removeNoScriptTags": true,
  "groupDuplicateImages": true,
  "maxSizeDuplicateImages": 524288,
  "imageReductionFactor": 1,
  "imageQuality": 0.8,
  "groupDuplicateStylesheets": false,
  "selfExtractingArchive": true,
  "extractDataFromPage": true,
  "filenameTemplate": "%if-empty<{page-title}|No title> ({date-locale} {time-locale}).{filename-extension}",
  "filenameConflictAction": "uniquify",
  "filenameReplacementCharacter": "_",
  "filenameReplacedCharacters": [
    "~",
    "+",
    "?",
    "%",
    "*",
    ":",
    "|",
    "\"",
    "<",
    ">",
    "\\\\",
    "\\x00-\\x1f",
    "\\x7f"
  ],
  "filenameMaxLength": 192,
  "filenameMaxLengthUnit": "bytes",
  "crawlInnerLinksOnly": true,
  "crawlRemoveURLFragment": true,
  "crawlMaxDepth": 1,
  "crawlExternalLinksMaxDepth": 1,
  "crawlSaveArchivePageTransitions": "auto",
  "userScriptEnabled": true,
  "animateInfobar": true,
  "infobarPositionTop": "16px",
  "infobarPositionBottom": "",
  "infobarPositionRight": "16px",
  "infobarPositionLeft": "",
  "insertCanonicalLink": true,
  "insertMetaCSP": true,
  "insertSingleFileComment": true,
  "resolveLinks": true,
  "maxParallelWorkers": 8,
  "settingsFileProfile": "default",
  "acceptHeaders": {
    "font": "application/font-woff2;q=1.0,application/font-woff;q=0.9,*/*;q=0.8",
    "image": "image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*;q=0.8",
    "stylesheet": "text/css,*/*;q=0.1",
    "script": "*/*",
    "document": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
  },
  "errorsTracesDisabled": true,
  "filenameReplacementCharacters": [
    "～",
    "＋",
    "？",
    "％",
    "＊",
    "：",
    "｜",
    "＂",
    "＜",
    "＞",
    "＼",
    "",
    ""
  ],
  "removeFrames": false,
  "displayStats": true
}