{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cqu-feed",
  "account_id": "a666c560407022706a52a703923548d5",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "version_metadata": {"binding":"CF_VERSION_METADATA"},
  "preview_urls": false,
  "routes": [{"pattern":"feed.cqu.moe", "custom_domain":true}],
  "assets": {"directory":"./dist", "binding":"ASSETS", "not_found_handling":"single-page-application", "run_worker_first":true},
  "vars": {
    "BASE_URL":"https://feed.cqu.moe",
    "AUTH_BASE_URL":"https://auth.cqu.moe",
    "POSTHOG_HOST":"https://p.cqu.moe",
    "ENVIRONMENT":"production",
    "MAX_FIRECRAWL_PER_DAY":"0",
    "MAX_OCR_PER_DAY":"0",
    "MAX_ARTICLES_PER_RUN":"5",
    "CRAWL_ENABLED":"true",
    "TASK_RUNTIME_ENABLED":"true",
    "MAIL_ENABLED":"true",
    "MAIL_FROM":"重大通知 <notifications@feed.cqu.moe>",
    "MAX_MAIL_ATTEMPTS":"6",
    "MAIL_PREPARE_LIMIT":"20",
    "DIGEST_MAX_ITEMS":"20",
    "DIGEST_MAX_BYTES":"65536",
    "SOURCE_MANAGEMENT_ENABLED":"true",
    "MAX_DISCOVERY_PAGES_PER_RUN":"2",
    "DISCOVERY_ADMISSION_RETENTION_MS":"604800000",
    "ARCHIVE_VERSIONS_ENABLED":"true",
    "ARCHIVE_READS_ENABLED":"true",
    "MAX_TASK_ATTEMPTS":"3",
    "TASK_MAX_LAUNCH_ATTEMPTS":"5",
    "TASK_LAUNCH_REPLAY_AFTER_MS":"900000",
    "TASK_RETRY_BASE_DELAY_MS":"900000",
    "TASK_RETRY_MAX_DELAY_MS":"21600000",
    "QUEUE_DEAD_LETTER_AFTER_MS":"900000",
    "OPERATIONS_DIAGNOSTIC_LIMIT":"20",
    "PDF_OCR_ENABLED":"true",
    "PDF_OCR_MODEL":"textin-xparse-auto",
    "MAX_PDF_OCR_PAGES_PER_DAY":"0",
    "MAX_PDF_OCR_PAGES_PER_MONTH":"0"
  },
  "triggers":{"crons":["*/5 * * * *"]},
  "workflows":[{"name":"cqu-feed-ingest","binding":"INGEST","class_name":"FeedIngest"},{"name":"cqu-feed-pdf-ocr","binding":"PDF_OCR","class_name":"PdfOcrWorkflow"},{"name":"cqu-feed-capture","binding":"CAPTURE","class_name":"CaptureWorkflow"},{"name":"cqu-feed-discovery","binding":"DISCOVERY","class_name":"DiscoveryWorkflow"},{"name":"cqu-feed-archive-ocr","binding":"ARCHIVE_OCR","class_name":"ArchiveOcrWorkflow"}],
  "queues":{"producers":[{"binding":"FEED_JOBS","queue":"feed-jobs"},{"binding":"FEED_EVENTS","queue":"feed-events"},{"binding":"FEED_MAIL","queue":"feed-mail"}],"consumers":[{"queue":"feed-mail","dead_letter_queue":"feed-mail-dlq","max_batch_size":5,"max_batch_timeout":5,"max_retries":5,"retry_delay":30},{"queue":"feed-jobs","dead_letter_queue":"feed-jobs-dlq","max_batch_size":10,"max_batch_timeout":5,"max_retries":5,"retry_delay":30},{"queue":"feed-events","dead_letter_queue":"feed-events-dlq","max_batch_size":10,"max_batch_timeout":5,"max_retries":5,"retry_delay":30}]},
  "d1_databases":[{"binding":"DB","database_name":"cqu-feed-mvp","database_id":"ba632f5c-c3b4-4f3c-ad57-1ac89895b02a","migrations_dir":"migrations"}],
  "r2_buckets":[{"binding":"ARCHIVE","bucket_name":"cqu-feed-archive"}],
  "ai":{"binding":"AI"},
  "services":[
    {"binding":"AUTH","service":"cqu-moe-auth"},
    {"binding":"AUTH_FEED_RPC","service":"cqu-moe-auth","entrypoint":"AuthService"}
  ],
  "limits":{"cpu_ms":30000},
  "observability":{"enabled":true,"head_sampling_rate":0.1,"redact_query_string":true,"logs":{"enabled":true,"invocation_logs":false},"traces":{"enabled":true,"head_sampling_rate":0.1}}
}
